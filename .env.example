# ---------------------------------------------------------------------------
# Statementra environment. Copy to .env and fill in. Never commit .env.
# Business settings (prices, copy, delivery times, AI thresholds, templates)
# are edited in the admin panel, not here.
# ---------------------------------------------------------------------------

APP_NAME=Statementra
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://statementra.com
BRAND_DOMAIN=statementra.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (MySQL 8 / MariaDB 10.6+) -------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=statementra
DB_USERNAME=statementra
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
CACHE_STORE=database

# No queue worker is needed: background work runs after the response is sent.
QUEUE_CONNECTION=sync

# --- Runtime (no cron, no queue worker) --------------------------------------
# Maintenance runs after normal page views. On a quiet site, point any uptime
# monitor (e.g. every 5 minutes) at https://YOUR-DOMAIN/system/heartbeat/{token};
# the token is shown in Admin → Settings → System. You may also set it here.
RUNTIME_HEARTBEAT_ON_TRAFFIC=true
RUNTIME_HEARTBEAT_TOKEN=
# The app calls itself to continue long AI work. Leave empty to use APP_URL; set
# it (e.g. http://127.0.0.1) only if the server cannot reach its own public URL.
RUNTIME_LOOPBACK_URL=
RUNTIME_LOOPBACK_VERIFY_TLS=true

# --- Admin panel ------------------------------------------------------------
ADMIN_PATH=admin
# Optional comma-separated IPs/CIDRs allowed to reach the admin panel.
ADMIN_IP_ALLOWLIST=
# First administrator (used once by `php artisan db:seed`); or run
# `php artisan statementra:create-admin you@example.com`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Paystack ---------------------------------------------------------------
# "test" or "live" ("mock" only works outside production, for local testing).
PAYSTACK_MODE=test
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CHANNELS=card,bank,ussd,bank_transfer,mobile_money
PAYSTACK_ENFORCE_WEBHOOK_IPS=false
PAYSTACK_WEBHOOK_IPS=52.31.139.75,52.49.173.169,52.214.14.220
PAYSTACK_TIMEOUT=20

# --- OpenAI -----------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=300
# Keep false unless you need responses stored on OpenAI's side.
OPENAI_STORE_RESPONSES=false
AI_DEFAULT_MODEL=gpt-6.1-sol
AI_WRITING_MODEL=gpt-6-astra

# --- Email ------------------------------------------------------------------
# SMTP works on any host (cPanel mail, Postmark, Resend, Brevo, Mailgun...).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="documents@statementra.com"
MAIL_FROM_NAME="${APP_NAME}"
EMAIL_MAX_ATTACHMENT_MB=15
# Delivery-status webhooks (optional): POST /webhooks/email/postmark or /webhooks/email/resend
POSTMARK_API_KEY=
POSTMARK_WEBHOOK_TOKEN=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- Customer files ---------------------------------------------------------
# Uploads and generated documents are encrypted (AES-256-GCM) on a private disk.
# Generate a key with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
FILE_ENCRYPTION_KEY=
FILE_ENCRYPTION_KEY_ID=k1
# When rotating keys: id:base64key,id2:base64key2
FILE_ENCRYPTION_PREVIOUS_KEYS=
FILESYSTEM_DISK=local
PRIVATE_FILES_DISK=private
PUBLIC_MEDIA_DISK=public

# Optional S3-compatible private storage (requires league/flysystem-aws-s3-v3).
PRIVATE_S3_KEY=
PRIVATE_S3_SECRET=
PRIVATE_S3_REGION=us-east-1
PRIVATE_S3_BUCKET=
PRIVATE_S3_ENDPOINT=
PRIVATE_S3_PATH_STYLE=false
PRIVATE_S3_SSE=AES256
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Malware scanning of uploads: "none" or "clamav" (needs a clamd daemon).
MALWARE_SCANNER=none
MALWARE_SCAN_FAIL_CLOSED=true
CLAMAV_SOCKET=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

# Text extraction and document checks (poppler-utils / LibreOffice). Optional:
# without pdftotext, PDF uploads are read by the AI from the file itself.
PDFTOTEXT_BINARY=/usr/bin/pdftotext
LIBREOFFICE_BINARY=soffice
VERIFY_DOCX_WITH_LIBREOFFICE=false

# --- Security & monitoring ---------------------------------------------------
# Only when REMOTE_ADDR shows a proxy instead of the visitor (e.g. Cloudflare in front of the
# server): the proxy IPs, or * if every request comes through a proxy that replaces the
# X-Forwarded-* headers. Leave empty otherwise (Hostinger's CDN already sets REMOTE_ADDR).
TRUSTED_PROXIES=
SECURITY_HSTS=true
# Optional Cloudflare Turnstile on public forms.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: Slack/Discord-compatible webhook for critical admin alerts.
ALERT_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"
